<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xlerobot_executive</name>
  <version>0.0.1</version>
  <description>Runs plans written by a planner as sequences of skills, with validation, pause, a planner lease and an event queue (ADR-0006).</description>
  <maintainer email="tfoldi@xsi.hu">Tamas Foldi</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>xlerobot_skill_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>xlerobot_skills</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
