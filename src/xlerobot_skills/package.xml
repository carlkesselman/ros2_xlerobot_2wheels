<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xlerobot_skills</name>
  <version>0.0.1</version>
  <description>The robot's skills as ROS 2 actions with one result contract (ADR-0006): navigate_to, look_at, detect, move_arm, approach.</description>
  <maintainer email="tfoldi@xsi.hu">Tamas Foldi</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>xlerobot_skill_msgs</depend>
  <depend>xlerobot_object_perception</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>xlerobot_bringup</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
