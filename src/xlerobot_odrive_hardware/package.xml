<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xlerobot_odrive_hardware</name>
  <version>0.1.0</version>
  <description>
    ros2_control hardware interface for the cart's two hub wheels on an ODESC / ODrive v3
    (firmware 0.5.x) over native USB. Reads the board's endpoint table at start instead of
    compiling one in, so any 0.5.x build works.
  </description>
  <maintainer email="carl@example.com">Carl</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>libusb-1.0-dev</depend>
  <depend>nlohmann-json-dev</depend>

  <test_depend>gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
