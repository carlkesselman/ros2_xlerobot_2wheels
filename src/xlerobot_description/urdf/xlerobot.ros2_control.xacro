<?xml version="1.0"?>
<!--
  One hardware interface per serial bus, plus one for the base. Carl's cart drives its
  wheels with brushless hub motors on an ODESC (ODrive v3, firmware 0.5.1, USB), not with
  servos on bus2:

    bus1:  left arm 1-6 (position) + head 7-8 (position)     sts_hardware_interface
    bus2:  right arm 1-6 (position)                           sts_hardware_interface
    base:  axis0 = right wheel, axis1 = left wheel (velocity) ODrive

  The wheel joints keep their names, so diff_drive_controller, the sim twin and the tools
  see the same two joints as on the servo base.

  Two instances of this plugin under one controller_manager work: both
  buses load, configure, and activate cleanly (adityakamath/sts_hardware_interface).
  Without instance_id, every instance opens an internal node with the same
  name and advertises /emergency_stop on the same absolute name, so a call
  only reaches one bus. Each bus below sets instance_id to its component
  name, giving /emergency_stop_xlerobot_bus1 and _bus2 (what
  tools/estop.py calls). Each still stops only its own bus, so don't build
  the safety supervisor around these, see ARCHITECTURE.md section 4.4.

  hold_position_on_activate must stay true: upstream defaults it to false, and then the
  position command sits at its initial 0.0 and torque-on drives every arm joint to the model's
  zero pose before any controller has written a command.

  Plugin uses its OWN mock mode (enable_mock_mode) rather than
  mock_components/GenericSystem, so use_mock_hardware:=true still exercises
  the real per-joint param parsing and mode assignment.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- read_only: no command interface, so the driver disables torque on the joint and
       never writes to it, while its state is still read every cycle. -->
  <xacro:macro name="sts_position_joint" params="name id lower upper center:=4095 rate_limit:=0 read_only:=false">
    <joint name="${name}">
      <param name="motor_id">${id}</param>
      <param name="operating_mode">0</param>
      <!-- servo step that is 0 rad, the driver reports (center - step) -->
      <param name="position_center_steps">${center}</param>
      <!-- the driver's own clamp, it ignores the command interface min/max below -->
      <param name="min_position">${lower}</param>
      <param name="max_position">${upper}</param>
      <!-- cap on how fast the commanded position may move, rad/s, 0 = none. The driver holds
           the target back to this speed, so a trajectory faster than that lags and the
           controller aborts it. -->
      <param name="position_rate_limit">${rate_limit}</param>
      <xacro:unless value="${read_only}">
        <command_interface name="position">
          <param name="min">${lower}</param>
          <param name="max">${upper}</param>
        </command_interface>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- safety supervisor uses these -->
      <state_interface name="temperature"/>
      <state_interface name="current"/>
      <state_interface name="voltage"/>
    </joint>
  </xacro:macro>

  <!-- One arm joint. The limits, the centre and the speed cap (1.25 x the planning velocity limit)
       come from arms.joints in robot_dimensions.yaml
       and match so101_arm.xacro: with direction +1 the model's joint is reversed against the
       source URDF, so the limits are mirrored. -->
  <xacro:macro name="sts_arm_joint" params="name id j side margin read_only">
    <xacro:property name="m" value="${-j['direction']}"/>
    <xacro:sts_position_joint name="${name}" id="${id}"
        lower="${min(m * j['lower'], m * j['upper']) - margin}" upper="${max(m * j['lower'], m * j['upper']) + margin}"
        center="${j['zero_step'][side]}" rate_limit="${1.25 * j['max_velocity']}" read_only="${read_only}"/>
  </xacro:macro>

  <!-- The six joints of one arm, IDs 1-6, names as in so101_arm.xacro. -->
  <xacro:macro name="sts_arm_joints" params="prefix side read_only joints margin">
    <xacro:sts_arm_joint name="${prefix}_shoulder_pan_joint"  id="1" j="${joints['shoulder_pan']}" side="${side}" margin="${margin}"  read_only="${read_only}"/>
    <xacro:sts_arm_joint name="${prefix}_shoulder_lift_joint" id="2" j="${joints['shoulder_lift']}" side="${side}" margin="${margin}" read_only="${read_only}"/>
    <xacro:sts_arm_joint name="${prefix}_elbow_flex_joint"    id="3" j="${joints['elbow_flex']}" side="${side}" margin="${margin}"    read_only="${read_only}"/>
    <xacro:sts_arm_joint name="${prefix}_wrist_flex_joint"    id="4" j="${joints['wrist_flex']}" side="${side}" margin="${margin}"    read_only="${read_only}"/>
    <xacro:sts_arm_joint name="${prefix}_wrist_roll_joint"    id="5" j="${joints['wrist_roll']}" side="${side}" margin="${margin}"    read_only="${read_only}"/>
    <xacro:sts_arm_joint name="${prefix}_gripper_joint"       id="6" j="${joints['gripper']}" side="${side}" margin="${margin}"       read_only="${read_only}"/>
  </xacro:macro>

  <!-- One drive wheel on the ODrive. axis is the board's axis number (0 = M0, 1 = M1). -->
  <xacro:macro name="odrive_wheel_joint" params="name axis wmax">
    <joint name="${name}">
      <param name="axis">${axis}</param>
      <command_interface name="velocity">
        <param name="min">${-wmax}</param>
        <param name="max">${wmax}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="xlerobot_ros2_control" params="bus1_port bus2_port use_mock_hardware with_arms torque_off with_head dims">

    <xacro:property name="b"      value="${dims['base']}"/>
    <xacro:property name="h"      value="${dims['head']}"/>
    <xacro:property name="wmax"   value="${dims['limits']['wheel_max_angular_velocity']}"/>

    <!-- ================= BUS 1 : left arm + head ================= -->
    <!-- Only declared when something is actually on it. Otherwise this
         component still tries to open bus1_port for zero joints, and on a
         base-only robot that port doesn't exist - controller_manager loads
         all hardware components in one process, so a bad bus1_port there
         takes the base down with it too. -->
    <xacro:if value="${with_arms or with_head}">
      <ros2_control name="xlerobot_bus1" type="system">
        <hardware>
          <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
          <param name="serial_port">${bus1_port}</param>
          <param name="instance_id">xlerobot_bus1</param>
          <param name="hold_position_on_activate">true</param>
          <param name="baud_rate">1000000</param>
          <param name="enable_mock_mode">$(arg use_mock_hardware)</param>
          <param name="proportional_vel_max">${dims['arms']['servo_speed_limit_steps']}</param>
        </hardware>

        <xacro:if value="${with_arms}">
          <xacro:sts_arm_joints prefix="left_arm" side="left" read_only="${torque_off}" joints="${dims['arms']['joints']}" margin="${dims['arms']['limit_margin']}"/>
        </xacro:if>

        <xacro:if value="${with_head}">
          <xacro:property name="pm" value="${-h['pan_direction']}"/>
          <xacro:property name="tm" value="${-h['tilt_direction']}"/>
          <xacro:sts_position_joint name="head_pan_joint"  id="7"
              lower="${min(pm * h['pan_limit_lower'], pm * h['pan_limit_upper'])}"
              upper="${max(pm * h['pan_limit_lower'], pm * h['pan_limit_upper'])}"
              center="${h['pan_zero_step']}" rate_limit="${1.25 * h['max_velocity']}" read_only="${torque_off}"/>
          <xacro:sts_position_joint name="head_tilt_joint" id="8"
              lower="${min(tm * h['tilt_limit_lower'], tm * h['tilt_limit_upper'])}"
              upper="${max(tm * h['tilt_limit_lower'], tm * h['tilt_limit_upper'])}"
              center="${h['tilt_zero_step']}" rate_limit="${1.25 * h['max_velocity']}" read_only="${torque_off}"/>
        </xacro:if>
      </ros2_control>
    </xacro:if>

    <!-- ================= BUS 2 : right arm ================= -->
    <!-- Only declared with the arms, for the same reason as bus1: with the wheels on the
         ODrive, nothing else is on this bus. -->
    <xacro:if value="${with_arms}">
      <ros2_control name="xlerobot_bus2" type="system">
        <hardware>
          <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
          <param name="serial_port">${bus2_port}</param>
          <param name="instance_id">xlerobot_bus2</param>
          <param name="hold_position_on_activate">true</param>
          <param name="baud_rate">1000000</param>
          <param name="enable_mock_mode">$(arg use_mock_hardware)</param>
          <param name="proportional_vel_max">${dims['arms']['servo_speed_limit_steps']}</param>
        </hardware>
        <xacro:sts_arm_joints prefix="right_arm" side="right" read_only="${torque_off}" joints="${dims['arms']['joints']}" margin="${dims['arms']['limit_margin']}"/>
      </ros2_control>
    </xacro:if>

    <!-- ================= BASE : two brushless wheels on the ODrive ================= -->
    <!-- Mock: ros2_control's own GenericSystem, which integrates the velocity command into the
         position state (calculate_dynamics), so diff_drive_controller gets odometry to difference.
         Real: the ODrive hardware interface is step 2 of docs/rosie-port-plan.md and doesn't exist
         yet, so asking for it stops xacro with a message instead of failing inside
         controller_manager.

         The left motor is the mirrored one on this cart. That sign lives in exactly one place,
         diff_drive_controller's left_wheel_radius_multiplier: -1.0 (controllers.yaml); the joints
         here report the raw axis, as the ODrive does. -->
    <xacro:property name="od" value="${b['odrive']}"/>
    <ros2_control name="xlerobot_base" type="system">
      <hardware>
        <xacro:if value="$(arg use_mock_hardware)">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="$(arg use_mock_hardware)">
          ${xacro.fatal('base: no ODrive hardware interface yet (step 2 of docs/rosie-port-plan.md); use use_mock_hardware:=true')}
        </xacro:unless>
      </hardware>
      <xacro:odrive_wheel_joint name="left_wheel_joint"  axis="${od['left_axis']}"  wmax="${wmax}"/>
      <xacro:odrive_wheel_joint name="right_wheel_joint" axis="${od['right_axis']}" wmax="${wmax}"/>
    </ros2_control>

  </xacro:macro>
</robot>
