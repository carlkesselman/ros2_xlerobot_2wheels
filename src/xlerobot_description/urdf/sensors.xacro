<?xml version="1.0"?>
<!--
  Sensor mount is sensor agnostic on purpose, see ADR-0003, the choice isn't
  made yet. sensor arg picks one of: none, usbcam, vlp16, gemini, realsense.
  Head mount frame is head_camera_mount, from head_pantilt.xacro.
  Lidar mount point is a placeholder until we know where it actually goes,
  might not even be on the head.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="xlerobot_sensors" params="sensor dims">

    <!-- The head camera the robot has today: a plain USB webcam, the same model
         as the wrist cameras (bringup cameras:=true, config/cameras.yaml). The shell
         is the printed one from the XLeRobot 3mf, placed with its lens hole centre on
         head_camera_link, whose position is the measured lens centre. -->
    <xacro:if value="${sensor == 'usbcam'}">
      <link name="head_camera_link">
        <visual>
          <origin xyz="-0.0115 0 -0.0094" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://xlerobot_description/meshes/upstream/head_camera_shell.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="xle_part"/>
        </visual>
      <collision>
          <origin xyz="-0.0115 0 -0.0094" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://xlerobot_description/meshes/upstream/head_camera_shell.stl" scale="0.001 0.001 0.001"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="0.03"/>
          <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
        </inertial>
      </link>
      <joint name="head_camera_joint" type="fixed">
        <parent link="head_camera_mount"/>
        <child  link="head_camera_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
      <!-- REP-103 optical frame, z forward -->
      <link name="head_camera_optical_frame"/>
      <joint name="head_camera_optical_joint" type="fixed">
        <parent link="head_camera_link"/>
        <child  link="head_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      </joint>
    </xacro:if>

    <!-- The D415 itself is drawn and collides as part of head_tilt_link (the Fusion model, see
         head_pantilt.xacro), head_camera_mount is its front glass centre. -->
    <xacro:if value="${sensor == 'realsense'}">
      <link name="head_camera_link">
        <inertial>
          <mass value="0.072"/>
          <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
        </inertial>
      </link>
      <joint name="head_camera_joint" type="fixed">
        <parent link="head_camera_mount"/>
        <child  link="head_camera_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
      <!-- REP-103 optical frame, z forward -->
      <link name="head_camera_optical_frame"/>
      <joint name="head_camera_optical_joint" type="fixed">
        <parent link="head_camera_link"/>
        <child  link="head_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      </joint>
    </xacro:if>

    <xacro:if value="${sensor == 'gemini'}">
      <!-- Orbbec Gemini 2 (confirmed via its own firmware + the vendor driver's device
           table, 2026-10-05 - project docs previously misidentified this as the original
           Gemini, see ADR-0003). Box size is a first-cut placeholder, not yet measured
           against the real unit - refine once it's mounted and visible.

           Unlike usbcam/realsense above, this link is NOT the camera's optical frame -
           it's named head_camera_link (project convention for "sits on head_camera_mount")
           but then connects, with identity rotation, to a second link named exactly
           "head_link": the orbbec_camera driver (gemini2.launch.py) publishes its own
           calibrated extrinsic TF tree rooted at "<camera_name>_link", not a fixed
           "camera_link" as first assumed - confirmed live only after passing
           camera_name:="head" (cameras.launch.py's actual invocation, needed for topic
           naming), which renames every frame in the tree with that prefix: head_link ->
           head_depth_frame -> head_{color,ir}_frame -> head_{color,ir}_optical_frame,
           plus head_{accel,gyro}_frame/_optical_frame. An earlier standalone test left
           camera_name at its own default ("camera"), which happened to render as
           "camera_link" and looked like a hardcoded constant - it wasn't. So this URDF
           only needs to place head_link at the right physical pose - the driver handles
           every per-stream optical frame itself, unlike usbcam/realsense which need the
           REP-103 remap done by hand below.

           Pitch is -0.1296 rad (7.4 deg nose up) relative to base_link. The camera's own IMU
           read 9.2 deg higher than the joints predicted, at head tilt 0 and at -0.59 rad, and a
           flat ChArUco board agrees to about 1.5 deg; 1.8 deg of that is the base's own lean
           (base.pitch_up in robot_dimensions.yaml). The roll and pitch (2.5 and 1.5 deg about the base axes at pan 0) make the
           table plane in the depth cloud level, the table measured level with a leveler. Position: the camera sits 45 mm further left
           (+y) than the mount centre, found by panning the head over a fixed ChArUco board (board position
           in the base frame scattered 8 mm before, 1.8 mm after). Roll (about 1 deg) and
           yaw are left at 0. -->
      <link name="head_camera_link">
        <visual>
          <geometry><box size="0.035 0.165 0.030"/></geometry>
          <material name="xle_black"/>
        </visual>
      <collision>
          <geometry><box size="0.035 0.165 0.030"/></geometry>
        </collision>
        <inertial>
          <mass value="0.12"/>
          <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
        </inertial>
      </link>
      <joint name="head_camera_joint" type="fixed">
        <parent link="head_camera_mount"/>
        <child  link="head_camera_link"/>
        <origin xyz="0.0052 0.0451 -0.0025" rpy="0.036680 -0.104329 0.019016"/>
      </joint>
      <link name="head_link"/>
      <joint name="head_link_joint" type="fixed">
        <parent link="head_camera_link"/>
        <child  link="head_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <xacro:if value="${sensor == 'vlp16'}">
      <!-- mount point is a guess, VLP-16 is 830g and needs its own bracket,
           not just bolted to the head like a camera -->
      <link name="lidar_mount"/>
      <joint name="lidar_mount_joint" type="fixed">
        <parent link="base_link"/>
        <child  link="lidar_mount"/>
        <origin xyz="0 0 ${dims['base']['body_height'] + 0.05}" rpy="0 0 0"/>
      </joint>
      <link name="velodyne">
        <visual>
          <geometry><cylinder radius="0.0516" length="0.0717"/></geometry>
          <material name="xle_black"/>
        </visual>
      <collision>
          <geometry><cylinder radius="0.0516" length="0.0717"/></geometry>
        </collision>
        <inertial>
          <mass value="0.83"/>
          <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
        </inertial>
      </link>
      <joint name="lidar_joint" type="fixed">
        <parent link="lidar_mount"/>
        <child  link="velodyne"/>
        <origin xyz="0 0 0.036" rpy="0 0 0"/>
      </joint>
    </xacro:if>

  </xacro:macro>
</robot>
