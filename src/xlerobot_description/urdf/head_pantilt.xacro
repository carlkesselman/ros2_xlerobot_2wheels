<?xml version="1.0"?>
<!--
  Neck and head pan/tilt, IDs 7 and 8 on bus1.

  Shoulders, neck, box, head and D415 are this cart's, from the Fusion model
  "XLeRobot 0.3 Upper Body" (meshes/cart, exported in Fusion's frame, mm: +x is
  the robot's front, +z up). The link frames and joint axes follow the upstream
  URDF (simulation/xlerobot/xlerobot.urdf of the XLeRobot repo): top_base_link
  and head_pan_link in the body frame (front is -x), head_tilt_link turned 180
  degrees about z so its x points to the front, which keeps the calibrated
  pan/tilt directions. Where the axes are comes from the servos in the Fusion
  model; the whole assembly is placed by head: mount_x/y (pan axis) and arms:
  mount_z (arm bases' bottom). Pan/tilt limits are upstream's, TODO check them
  against the mechanical stops.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="xlerobot_head" params="dims parent sensor">
    <xacro:property name="h" value="${dims['head']}"/>

    <!-- Fusion model points, mm in its frame, from the servo horns (the STS3215's output is
         12.5 mm off its body centre, 20.2 mm above it, in each servo's own frame):
         pan axis vertical through x -193.66, y 6.02, the pan horn's face at z 1116.80; tilt axis
         along y through x -162.81, z 1169.24; the D415's front glass centred at x -128.4, y 9.25,
         z 1195.4; the arm bases' bottom at z 759.3. -->
    <xacro:property name="f_pan_x" value="-0.19366"/>
    <xacro:property name="f_pan_y" value="0.00602"/>
    <xacro:property name="f_pan_z" value="1.11680"/>
    <xacro:property name="f_tilt_x" value="-0.16281"/>
    <xacro:property name="f_tilt_z" value="1.16924"/>
    <xacro:property name="f_arm_z" value="0.7593"/>

    <!-- The top base sits 0.045 m below the arm mounting surface and 0.103 m ahead of the
         pan axis, as in the upstream URDF. Fusion's frame is turned 180 degrees about z into it
         with the pan axis at x -0.103 and the arm bases' bottom at arms: mount_z. -->
    <xacro:property name="top_base_z" value="${dims['arms']['mount_z'] - 0.045}"/>
    <xacro:property name="cart_mesh_xyz" value="${-0.103 + f_pan_x} ${f_pan_y} ${0.045 - f_arm_z}"/>
    <!-- pan joint at the pan horn's face, 1.1178 m above the floor -->
    <xacro:property name="pan_dz" value="${0.045 + f_pan_z - f_arm_z}"/>
    <joint name="top_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="top_base_link"/>
      <origin xyz="${h['mount_x'] + 0.103} ${h['mount_y']} ${top_base_z}" rpy="0 0 0"/>
    </joint>

    <link name="top_base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2542"/>
        <inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0045"/>
      </inertial>
      <!-- Shoulders (two clips on the top basket's rear rim, the arm bases on top), the box
           behind the neck, the neck, the head base and the pan servo with its holder. The
           holder is 67k triangles and inside the head base, so it has no collision. -->
      <visual>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/shoulder_left.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/shoulder_left.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/shoulder_right.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/shoulder_right.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/pi_case.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
      <collision>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/pi_case.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/neck.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/neck.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_base_motor_holder.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
      <visual>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_pan_servo.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_black"/>
      </visual>
      <collision>
        <origin xyz="${cart_mesh_xyz}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_pan_servo.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <link name="head_pan_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2556"/>
        <inertia ixx="0.0129" ixy="0" ixz="0" iyy="0.0095" iyz="0" izz="0.0184"/>
      </inertial>
      <!-- pan bracket, tilt servo holder and tilt servo; one box for collision -->
      <visual>
        <origin xyz="${f_pan_x} ${f_pan_y} ${-f_pan_z}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_pan_bracket.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <visual>
        <origin xyz="${f_pan_x} ${f_pan_y} ${-f_pan_z}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_tilt_motor_holder.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <visual>
        <origin xyz="${f_pan_x} ${f_pan_y} ${-f_pan_z}" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_tilt_servo.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_black"/>
      </visual>
      <collision>
        <origin xyz="-0.0191 -0.0012 0.0074" rpy="0 0 0"/>
        <geometry><box size="0.0635 0.055 0.1107"/></geometry>
      </collision>
    </link>

    <joint name="head_pan_joint" type="revolute">
      <parent link="top_base_link"/>
      <child link="head_pan_link"/>
      <origin xyz="-0.103 0 ${pan_dz}" rpy="0 0 ${h['pan_zero_yaw']}"/>
      <axis xyz="0 0 ${-h['pan_direction']}"/>
      <limit lower="${min(-h['pan_direction'] * h['pan_limit_lower'], -h['pan_direction'] * h['pan_limit_upper'])}" upper="${max(-h['pan_direction'] * h['pan_limit_lower'], -h['pan_direction'] * h['pan_limit_upper'])}" effort="2.0" velocity="${h['max_velocity']}"/>
    </joint>

    <link name="head_tilt_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.02087"/>
        <inertia ixx="0.0061" ixy="0" ixz="0" iyy="0.0014" iyz="0" izz="0.0061"/>
      </inertial>
      <!-- camera mount and the D415, a box each for collision -->
      <visual>
        <origin xyz="${-f_tilt_x} ${-f_pan_y} ${-f_tilt_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/head_tilt_camera_mount.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <visual>
        <origin xyz="${-f_tilt_x} ${-f_pan_y} ${-f_tilt_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/cart/d415.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_black"/>
      </visual>
      <collision>
        <origin xyz="0.0004 0.0024 0.0114" rpy="0 0 0"/>
        <geometry><box size="0.0247 0.0636 0.0473"/></geometry>
      </collision>
      <collision>
        <origin xyz="0.0228 0.0032 0.0262" rpy="0 0 0"/>
        <geometry><box size="0.0233 0.0989 0.0232"/></geometry>
      </collision>
    </link>

    <joint name="head_tilt_joint" type="revolute">
      <parent link="head_pan_link"/>
      <child link="head_tilt_link"/>
      <origin xyz="${-(f_tilt_x - f_pan_x)} 0 ${f_tilt_z - f_pan_z}" rpy="0 0 3.1415927"/>
      <axis xyz="0 ${h['tilt_direction']} 0"/>
      <limit lower="${min(-h['tilt_direction'] * h['tilt_limit_lower'], -h['tilt_direction'] * h['tilt_limit_upper'])}" upper="${max(-h['tilt_direction'] * h['tilt_limit_lower'], -h['tilt_direction'] * h['tilt_limit_upper'])}" effort="2.0" velocity="${h['max_velocity']}"/>
    </joint>

    <!-- sensor gets attached here, in sensors.xacro: the D415's front glass centre -->
    <link name="head_camera_mount"/>
    <joint name="head_camera_mount_joint" type="fixed">
      <parent link="head_tilt_link"/>
      <child link="head_camera_mount"/>
      <origin xyz="${-0.1284 - f_tilt_x} ${0.00925 - f_pan_y} ${1.1954 - f_tilt_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
